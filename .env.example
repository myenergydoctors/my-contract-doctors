# Copy to .env.local and fill in real values. Never commit .env.local.

# Anthropic — powers invoice/agreement extraction and the chat widget
ANTHROPIC_API_KEY=

# SendGrid — contact form notification + confirmation emails
SENDGRID_API_KEY=

# Supabase — auth, database, and file storage
# Project settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — keep out of anything NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Scheduled account notifications. Email still requires per-user opt-in.
CRON_SECRET=
NOTIFICATION_SIGNING_SECRET=
NOTIFICATION_EMAILS_ENABLED=false
# Optional local QA origin; omit in Vercel to use its preview URL / canonical site.
NOTIFICATION_APP_URL=
