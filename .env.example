# Copy to .env.local and fill in real values. Never commit .env.local.

# Anthropic — powers invoice/agreement extraction and the chat widget
ANTHROPIC_API_KEY=

# SendGrid — contact form notification + confirmation emails
SENDGRID_API_KEY=

# Supabase — auth, database, and file storage
# Project settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — keep out of anything NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
